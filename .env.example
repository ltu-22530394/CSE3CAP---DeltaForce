# Local proof of concept
API_PORT=4000
APP_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
GAPS_DB_FILE=server/data/gaps.sqlite
DEMO_STAFF_ENABLED=true
DEMO_STAFF_PASSWORD=Greyhound2026!
APP_TIMEZONE=Australia/Sydney
BACKUP_ENABLED=true
BACKUP_DIR=server/backups
# Set to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0

# Optional private first-administrator setup. Use a separate email from applicants.
# All three values are required together; password must be 16+ characters, max 72 UTF-8 bytes.
# Never commit real credentials. Existing administrator passwords are not reset on startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# No SMTP/Brevo, Microsoft SSO, or email-verification configuration is needed.
GOOGLE_CLIENT_ID=

# Optional read-only Salesforce API. CSV needs no credentials.
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v65.0
SALESFORCE_GREYHOUND_OBJECT=
SALESFORCE_FIELD_MAP=
# Example only: replace with the client's actual object and field API names.
# SALESFORCE_GREYHOUND_OBJECT=Greyhound__c
# SALESFORCE_FIELD_MAP={"id":"Identifier__c","name":"Name","age":"Age__c","sex":"Sex__c","careInstructions":"Care_Instructions__c"}

# Public contacts and approved privacy/terms URLs are configured in Administration.
