API_PORT=4000
APP_ORIGIN=http://localhost:5173
# Set to /CSE3CAP---DeltaForce for a frontend hosted at that URL prefix.
APP_BASE_PATH=
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1h
GAPS_DB_FILE=server/data/gaps.sqlite
VITE_API_URL=http://localhost:4000
STAFF_EMAIL=jamie@gap.example
STAFF_NAME=Jamie Morgan
STAFF_PASSWORD=
REQUIRE_EMAIL_VERIFICATION=true
# Delivery is disabled until a sender is configured. Queued messages remain in SQLite.
MAIL_WORKER_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A separate long random secret; keep stable while messages are queued.
MAIL_ENCRYPTION_KEY=
